extends layout.pug

block content
  .u-row-container(style="padding:0; background-color:transparent")
    .u-row(style="margin:0 auto; max-width:600px; background-color:transparent")
      .u-col.u-col-100(style="min-width:600px;")
        table(font-family="helvetica, sans-serif", role="presentation", width="100%")
          tbody
            tr
              td(style="padding:10px; text-align:center;")
                div(style="font-size:18px; line-height:140%")
                  p Ласкаво просимо до Pizza House!
                  p Будь ласка, натисніть кнопку нижче, щоб підтвердити вашу електронну пошту.

  include components/button.pug
  +button(frontendUrl + '/email-verification?token=' + token, 'Підтвердити')