html(xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office")
	head
		meta(http-equiv="Content-Type", content="text/html; charset=UTF-8")
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		meta(name="x-apple-disable-message-reformatting")
		meta(http-equiv="X-UA-Compatible", content="IE=edge")
		title Pizza House
		style.
			@media only screen and (min-width: 620px) {
				.u-row { width: 600px !important; }
				.u-row .u-col { vertical-align: top; }
				.u-row .u-col-100 { width: 600px !important; }
			}
			@media only screen and (max-width: 620px) {
				.u-row-container { max-width: 100% !important; padding-left: 0px !important; padding-right: 0px !important; }
				.u-row { width: 100% !important; }
				.u-row .u-col { display: block !important; width: 100% !important; min-width: 320px !important; max-width: 100% !important; }
				.u-row .u-col > div { margin: 0 auto; }
			}
			body { margin: 0; padding: 0; }
			table, td, tr { border-collapse: collapse; vertical-align: top; }
			p { margin: 0; }
			.ie-container table, .mso-container table { table-layout: fixed; }
			* { line-height: inherit; }
			a[x-apple-data-detectors=true] { color: inherit !important; text-decoration: none !important; }
			table, td { color: #000000; }
			#u_body a { color: #000000; text-decoration: underline; }

	body.clean-body.u_body(style="margin:0; padding:0; background-color:#ffffff; color:#000000;")
		table#u_body(role="presentation", cellpadding="0", cellspacing="0", width="100%", style="min-width:320px; margin:0 auto; background-color:#ffffff;")
			tbody
				tr
					td
						.u-row-container(style="padding:0; background-color:transparent")
							.u-row(style="margin:0 auto; max-width:600px; background-color:transparent")
								.u-col.u-col-100(style="min-width:600px;")
									table(font-family="helvetica, sans-serif", role="presentation", width="100%")
										tbody
											tr
												td(style="padding:10px 10px 25px; text-align:center;")
													//- h1(style="font-size:24px; font-weight:700;") Pizza House
													a(rel="noopener", href=frontendUrl, target="_blank")
														img(align="center" border="0" src="https://raw.githubusercontent.com/kvartsianyi/pizza-house-api/refs/heads/development/src/public/images/shop-logo-wide.png" width="200")

						block content

						.u-row-container(style="padding:0; background-color:transparent")
							.u-row(style="margin:0 auto; max-width:600px; background-color:transparent")
								.u-col.u-col-100(style="min-width:600px;")
									table(font-family="helvetica, sans-serif", role="presentation", width="100%")
										tbody
											tr
												td(style="padding:10px; text-align:center;")
													div(style="font-size:14px; line-height:140%")
														p © #{year} Pizza House. All rights reserved.


		