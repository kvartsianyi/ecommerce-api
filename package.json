{
  "name": "ecommerce-api",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "prepare": "husky",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "author": "Yuriy Kvartsianiy",
  "license": "ISC",
  "description": "",
  "keywords": [
    "ecommerce",
    "api"
  ],
  "dependencies": {
    "express": "^5.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.12",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsc": "^2.0.4",
    "tsx": "^4.20.3"
  }
}
