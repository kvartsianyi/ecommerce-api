{
  "name": "ecommerce-api",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "prepare": "husky",
    "start": "node --env-file=.env dist/src/index.js",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "build": "npx rimraf dist && tsc && tsc-alias && copyfiles \"./src/db/migrations/*.sql\" dist",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrations": "npx drizzle-kit migrate",
    "migrations:down": "tsx --env-file=.env src/db/migrations/migrations-down.ts",
    "seeds": "tsx --env-file=.env src/db/seeds/index.ts"
  },
  "author": "Yuriy Kvartsianiy",
  "license": "ISC",
  "description": "",
  "keywords": [
    "ecommerce",
    "api"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pug": "^3.0.3",
    "typescript": "^5.8.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.12",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.4",
    "@types/pug": "^2.0.10",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsc": "^2.0.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3"
  }
}
